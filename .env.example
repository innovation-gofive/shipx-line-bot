NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Origin only, e.g. https://shipx-api.example.com (no /api suffix).
SHIPX_BASE_URL=
# The supplied OpenAPI declares both in a single security object (AND).
# Confirm actual server requirements; set both if required. No guessed login flow.
SHIPX_API_KEY=
SHIPX_BEARER_TOKEN=
# Optional: AI command planning and verified response presentation.
OPENAI_API_KEY=
# Optional HTTPS API base including its version prefix, for example https://gateway.example.com/v1.
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
# Empty = use OPENAI_MODEL.
OPENAI_RESPONSE_MODEL=
AI_RESPONSE_ENABLED=true
# Confirmed for this project: Order.ShippingDate is the scheduled shipping date.
SHIPX_SHIPPING_DATE_IS_DUE_DATE=true
DATABASE_PATH=./data/shipx.sqlite
# Demo ignores DATABASE_PATH and must use a different file.
DEMO_DATABASE_PATH=./data/demo.sqlite
