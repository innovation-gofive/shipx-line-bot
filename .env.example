NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# API origin. A trailing /api is accepted and normalized to the origin.
SHIPX_BASE_URL=
# auto prefers an API key. Set both only when the ShipX deployment requires both credentials.
SHIPX_AUTH_MODE=auto
SHIPX_API_KEY=
SHIPX_BEARER_TOKEN=
# Optional: AI command planning and verified response presentation.
OPENAI_API_KEY=
# HTTPS API base including its version prefix. Requests append /responses.
OPENAI_BASE_URL=https://llm-gateway.tks.co.th/v1
OPENAI_MODEL=gemma-4-31B-it-qat-w4a16
# Empty = use OPENAI_MODEL.
OPENAI_RESPONSE_MODEL=
AI_RESPONSE_ENABLED=true
# Confirmed for this project: Order.ShippingDate is the scheduled shipping date.
SHIPX_SHIPPING_DATE_IS_DUE_DATE=true
DATABASE_PATH=./data/shipx.sqlite
# Demo ignores DATABASE_PATH and must use a different file.
DEMO_DATABASE_PATH=./data/demo.sqlite
